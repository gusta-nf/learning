CREATE TABLE Autor (
id_autor INTEGER NOT NULL,
nome_autor VARCHAR(100) NOT NULL,
nacionalidade VARCHAR(50),
CONSTRAINT pk_autor PRIMARY KEY(id_autor)
);

CREATE TABLE Editora (
id_editora INTEGER NOT NULL,
nome_editora VARCHAR(100) NOT NULL,
cidade VARCHAR(50),
CONSTRAINT pk_editora PRIMARY KEY(id_editora)
);

CREATE TABLE Livro (
isbn VARCHAR(20) NOT NULL,
titulo VARCHAR(255) NOT NULL,
ano_publicacao INTEGER,
id_autor INTEGER,
id_editora INTEGER,
CONSTRAINT pk_livro PRIMARY KEY(isbn),
CONSTRAINT fk_autor FOREIGN KEY(id_autor)
	REFERENCES Autor(id_autor)
	ON UPDATE CASCADE
	ON DELETE RESTRICT,
CONSTRAINT fk_editora FOREIGN KEY(id_editora)
	REFERENCES Editora(id_editora)
	ON UPDATE CASCADE
	ON DELETE RESTRICT
);

CREATE TABLE Membro (
id_membro INTEGER NOT NULL,
nome_membro VARCHAR(100) NOT NULL,
telefone VARCHAR(15),
CONSTRAINT pk_membro PRIMARY KEY(id_membro)
);

CREATE TABLE Emprestimo (
id_emprestimo INTEGER NOT NULL,
isbn_livro VARCHAR(20),
id_membro INTEGER,
data_emprestimo DATE NOT NULL,
data_devolucao DATE,
CONSTRAINT pk_emprestimo PRIMARY KEY(id_emprestimo),
CONSTRAINT fk_livro FOREIGN KEY(isbn_livro)
	REFERENCES Livro(isbn)
	ON UPDATE CASCADE
	ON DELETE RESTRICT,
CONSTRAINT fk_membro FOREIGN KEY(id_membro)
	REFERENCES Membro(id_membro)
	ON UPDATE CASCADE
	ON DELETE RESTRICT
);

